{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eidryan/slideskill/blob/main/schemas/deck.schema.json",
  "title": "Slide Director manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "audience",
        "purpose",
        "mode",
        "language",
        "data_status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5
        },
        "audience": {
          "type": "string",
          "minLength": 3
        },
        "purpose": {
          "type": "string",
          "minLength": 10
        },
        "mode": {
          "enum": [
            "live",
            "read_only",
            "hybrid"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "data_status": {
          "enum": [
            "illustrative",
            "sourced"
          ]
        },
        "duration_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "title",
          "claim",
          "relation",
          "layout",
          "evidence",
          "visual_plan",
          "notes",
          "decision_log"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 3
          },
          "title": {
            "type": "string",
            "minLength": 10
          },
          "claim": {
            "type": "string",
            "minLength": 10
          },
          "relation": {
            "enum": [
              "thesis",
              "decomposition",
              "multiplicative",
              "comparison",
              "magnitude_comparison",
              "sequence",
              "recommendation",
              "decision"
            ]
          },
          "layout": {
            "enum": [
              "thesis_cover",
              "driver_tree",
              "comparison_matrix",
              "bar_chart",
              "sequence",
              "recommendation"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "text"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "conceptual",
                    "qualitative",
                    "quantitative"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 3
                },
                "source": {
                  "type": "string",
                  "minLength": 3
                },
                "units": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "visual_plan": {
            "type": "object",
            "minProperties": 1
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "decision_log": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selected_reason",
              "alternatives_rejected",
              "reference_ids"
            ],
            "properties": {
              "selected_reason": {
                "type": "string",
                "minLength": 10
              },
              "alternatives_rejected": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "reference_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
